<%# locals: (recurring_transaction:) %>

<%= styled_form_with model: recurring_transaction, class: "space-y-4", data: { turbo_frame: "_top" } do |f| %>
  <% if recurring_transaction.errors.any? %>
    <%= render "shared/form_errors", model: recurring_transaction %>
  <% end %>

  <% if recurring_transaction.new_record? %>
    <section>
      <%= render "recurring_transactions/kind_tabs", active_kind: recurring_transaction.kind %>
    </section>
  <% end %>

  <%= f.hidden_field :kind %>

  <section class="space-y-2">
    <% if recurring_transaction.transfer? %>
      <%= f.collection_select :account_id, @accounts, :id, :name, { prompt: "Select account", label: "From" }, required: true %>
      <%= f.collection_select :destination_account_id, @accounts, :id, :name, { prompt: "Select account", label: "To" }, required: true %>
    <% else %>
      <%= f.text_field :name, label: "Description", placeholder: "e.g. Claude subscription", required: true %>
      <%= f.collection_select :account_id, @accounts, :id, :name, { prompt: "Select account", label: "Account" }, required: true %>
    <% end %>

    <%= f.number_field :amount, label: "Amount", required: true, min: 0, step: 0.01, placeholder: "100" %>

    <% unless recurring_transaction.transfer? %>
      <% categories = recurring_transaction.income? ? @income_categories : @expense_categories %>
      <%= f.collection_select :category_id, categories, :id, :name, { prompt: "Select category", label: "Category" } %>
    <% end %>

    <%= f.select :frequency,
                 RecurringTransaction.frequencies.keys.map { |freq| [ freq.humanize, freq ] },
                 { label: "Repeats" },
                 required: true %>
    <%= f.date_field :start_date, label: "Starts on", required: true, min: Entry.min_supported_date %>
    <%= f.date_field :end_date, label: "Ends on (optional)", min: Entry.min_supported_date %>
  </section>

  <% if recurring_transaction.new_record? %>
    <p class="text-xs text-secondary">Occurrences on or before today are posted right away. Future occurrences are posted automatically on their due date.</p>
  <% end %>

  <section>
    <%= f.submit recurring_transaction.new_record? ? "Create recurring #{recurring_transaction.kind}" : "Save changes" %>
  </section>
<% end %>
